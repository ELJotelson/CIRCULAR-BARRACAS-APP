<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.Pages.NominaPage"
             Title="Nómina">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" MaximumWidthRequest="720" HorizontalOptions="Center">

        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <Label Text="Nómina de empleados" Style="{StaticResource Headline}" FontSize="22" />
            <Label x:Name="SubtituloLabel" Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="ImportarSection" Grid.Row="1" Spacing="10" Margin="0,0,0,10">
            <Button x:Name="ImportarButton" Text="📄  Importar Excel/CSV" Clicked="OnImportarClicked" />
            <Button x:Name="EliminarListaButton" Text="🗑  Eliminar por lista (Excel/CSV)" Style="{StaticResource DangerButton}" Clicked="OnEliminarListaClicked" />

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <Entry x:Name="NuevoLegajoEntry" Grid.Column="0" Placeholder="Legajo" />
                <Entry x:Name="NuevoNombreEntry" Grid.Column="1" Placeholder="Nombre" />
                <Button Grid.Column="2" Text="Agregar" Clicked="OnAgregarEmpleadoClicked" />
            </Grid>

            <ActivityIndicator x:Name="ImportandoIndicator" IsRunning="False" IsVisible="False" />
            <Label x:Name="ResultadoLabel" IsVisible="False" />
        </VerticalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <SearchBar Grid.Column="0"
                       x:Name="BuscarEmpleadoSearchBar"
                       Placeholder="Buscar por nombre o legajo..."
                       TextChanged="OnBuscarTextChanged" />
            <Button Grid.Column="1" Text="📤 Exportar" Clicked="OnExportarClicked" />
        </Grid>

        <CollectionView Grid.Row="3" x:Name="ListaEmpleados">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Dar de baja"
                                           BackgroundColor="{StaticResource Danger}"
                                           Invoked="OnDarDeBajaSwipe" />
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="#8B0000"
                                           Invoked="OnEliminarSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Nombre}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" Style="{StaticResource FieldLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
