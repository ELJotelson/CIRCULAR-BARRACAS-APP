<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.Pages.LoginPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="28"
                                  Spacing="18"
                                  MaximumWidthRequest="420"
                                  HorizontalOptions="Center">

                <Label Text="Desvíos en Plantas"
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="Reporte de desvíos en planta"
                       Style="{StaticResource SubHeadline}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="EmailEntry"
                                   Placeholder="tu@empresa.com"
                                   Keyboard="Email" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Contraseña" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="••••••••"
                                   IsPassword="True" />
                        </VerticalStackLayout>

                        <Label x:Name="ErrorLabel"
                               TextColor="{StaticResource Danger}"
                               IsVisible="False" />

                        <Button x:Name="IngresarButton"
                                Text="Ingresar"
                                Clicked="OnIngresarClicked" />

                        <ActivityIndicator x:Name="CargandoIndicator"
                                            IsRunning="False"
                                            IsVisible="False" />

                        <Button Text="Olvidé mi contraseña"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnOlvideClicked" />

                        <Button Text="Crear cuenta nueva"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnCrearCuentaClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
