<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.Pages.MotivosDesvioPage"
             Title="Motivos de desvío">

    <Grid RowDefinitions="Auto,*" Padding="16" MaximumWidthRequest="640" HorizontalOptions="Center">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <Entry x:Name="NombreNuevoEntry" Grid.Column="0" Placeholder="Motivo nuevo" />
            <Button Grid.Column="1" Text="Agregar" Clicked="OnAgregarClicked" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="ListaItems">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Desactivar"
                                           BackgroundColor="{StaticResource Danger}"
                                           Invoked="OnDesactivarSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                            <Label Text="{Binding Nombre}" Style="{StaticResource SectionTitle}" FontSize="15" />
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
