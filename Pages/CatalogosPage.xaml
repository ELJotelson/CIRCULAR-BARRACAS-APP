<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.Pages.CatalogosPage"
             Title="Catálogos">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" MaximumWidthRequest="640" HorizontalOptions="Center">

        <Picker x:Name="CatalogoPicker" Grid.Row="0" Title="Elegir catálogo" SelectedIndexChanged="OnCatalogoChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Lugares</x:String>
                    <x:String>Tipos de desvío</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,12">
            <Entry x:Name="NombreNuevoEntry" Grid.Column="0" Placeholder="Nombre nuevo" />
            <Button Grid.Column="1" Text="Agregar" Clicked="OnAgregarClicked" />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="ListaItems">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Desactivar"
                                           BackgroundColor="{StaticResource Danger}"
                                           Invoked="OnDesactivarSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                            <Label Text="{Binding Nombre}" Style="{StaticResource SectionTitle}" FontSize="15" />
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
