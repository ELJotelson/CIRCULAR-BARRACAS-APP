<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Circulacion_Barracas"
             x:Class="Circulacion_Barracas.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#121212}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>