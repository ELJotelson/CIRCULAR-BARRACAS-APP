<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.ListaDesviosPage"
             Title="Lista de Desvíos">

    <StackLayout Padding="10"
                 BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

        <Picker x:Name="EmpleadoPicker"
                Title="Filtrar por empleado"
                SelectedIndexChanged="OnEmpleadoFiltroChanged"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                Margin="0,0,0,10" />

        <Button Text="Exportar a Excel"
                Clicked="OnExportarExcelClicked"
                BackgroundColor="Green"
                TextColor="White"
                Margin="0,0,0,10"/>

        <CollectionView x:Name="ListaDesvios">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="Red"
                                           Invoked="OnEliminarSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame BorderColor="{AppThemeBinding Light=#D0D0D0, Dark=#3A3A3A}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="10"
                               Padding="10"
                               Margin="5">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="{Binding Empleado}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                                <Label Text="{Binding Inspector, StringFormat='Inspector: {0}'}"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                <Label Text="{Binding Lugar, StringFormat='Lugar: {0}'}"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                <Label Text="{Binding TipoDesvio, StringFormat='Tipo: {0}'}"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                <Label Text="{Binding Observaciones, StringFormat='Observaciones: {0}'}"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                                <Label Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                <Image Source="{Binding FotoPath}"
                                       HeightRequest="120"
                                       WidthRequest="180"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Start">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageTapped" />
                                    </Image.GestureRecognizers>
                                </Image>

                            </VerticalStackLayout>
                        </Frame>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </StackLayout>
</ContentPage>