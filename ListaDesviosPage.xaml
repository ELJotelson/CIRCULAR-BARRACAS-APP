<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.ListaDesviosPage"
             Title="Lista de Desvíos"
             BackgroundColor="#E8F5E9">

    <VerticalStackLayout Padding="10" Spacing="10">

        <Picker x:Name="EmpleadoPicker"
                Title="Filtrar por empleado"
                SelectedIndexChanged="OnEmpleadoFiltroChanged" />

        <Button Text="Exportar a Excel"
                BackgroundColor="Green"
                TextColor="White"
                Clicked="OnExportarExcelClicked" />

        <CollectionView x:Name="ListaDesvios">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="Red"
                                           Invoked="OnEliminarSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="#C8E6C9"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 15"
                                Padding="10"
                                Margin="5">

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Inspector}"
                                       FontAttributes="Bold"
                                       FontSize="18" />

                                <Label Text="{Binding Empleado}"
                                       TextColor="DarkGreen"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Lugar}" />
                                <Label Text="{Binding TipoDesvio}" />
                                <Label Text="{Binding Observaciones}" />
                                <Label Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" />

                                <Image Source="{Binding FotoPath}"
                                       HeightRequest="120"
                                       WidthRequest="180"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>