<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.MainPage"
             Title="Nuevo Desvío"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Carga de Desvíos"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="DarkGreen"
                   HorizontalOptions="Center" />

            <Picker x:Name="InspectorPicker"
                    Title="Seleccionar inspector" />

            <Label Text="Empleado"
                   FontAttributes="Bold"
                   TextColor="DarkGreen" />

            <SearchBar x:Name="EmpleadoSearchBar"
                       Placeholder="Buscar por legajo o nombre"
                       TextChanged="OnEmpleadoSearchTextChanged" />

            <Picker x:Name="EmpleadoPicker"
                    Title="Seleccionar empleado" />

            <Picker x:Name="LugarPicker"
                    Title="Seleccionar lugar" />

            <Picker x:Name="DesvioPicker"
                    Title="Tipo de desvío">
                <Picker.Items>
                    <x:String>Leve</x:String>
                    <x:String>Moderado</x:String>
                    <x:String>Grave</x:String>
                </Picker.Items>
            </Picker>

            <Editor x:Name="ObservacionesEditor"
                    Placeholder="Observaciones"
                    AutoSize="TextChanges"
                    HeightRequest="120" />

            <Image x:Name="FotoPreview"
                   HeightRequest="180"
                   WidthRequest="220"
                   Aspect="AspectFill"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <Button Text="Sacar Foto"
                    BackgroundColor="#43A047"
                    TextColor="White"
                    Clicked="OnTomarFotoClicked" />

            <Button Text="Guardar"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnGuardarClicked" />

            <Button Text="Ver Desvíos"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    Clicked="OnVerListaClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>