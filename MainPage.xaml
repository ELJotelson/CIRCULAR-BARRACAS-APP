<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Circulacion_Barracas.MainPage"
             Title="Carga de Desvío">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">

            <!-- INSPECTOR -->
            <Label Text="Inspector"
                   FontAttributes="Bold"/>
            <Picker x:Name="InspectorPicker"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- BUSCAR EMPLEADO -->
            <Label Text="Buscar Empleado"
                   FontAttributes="Bold"/>
            <SearchBar x:Name="EmpleadoSearchBar"
                       Placeholder="Escribí para filtrar..."
                       TextChanged="OnEmpleadoSearchTextChanged"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- EMPLEADO -->
            <Label Text="Empleado"
                   FontAttributes="Bold"/>
            <Picker x:Name="EmpleadoPicker"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- LUGAR -->
            <Label Text="Lugar"
                   FontAttributes="Bold"/>
            <Picker x:Name="LugarPicker"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- TIPO DESVIO -->
            <Label Text="Tipo de Desvío"
                   FontAttributes="Bold"/>
            <Picker x:Name="DesvioPicker"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- OBSERVACIONES -->
            <Label Text="Observaciones"
                   FontAttributes="Bold"/>
            <Editor x:Name="ObservacionesEditor"
                    HeightRequest="100"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- FOTO -->
            <Button Text="Tomar Foto"
                    Clicked="OnTomarFotoClicked"
                    BackgroundColor="DodgerBlue"
                    TextColor="White" />

            <Image x:Name="FotoPreview"
                   HeightRequest="200"
                   IsVisible="False"
                   Aspect="AspectFit" />

            <!-- BOTÓN GUARDAR -->
            <Button Text="Guardar"
                    Clicked="OnGuardarClicked"
                    BackgroundColor="Green"
                    TextColor="White" />

            <!-- BOTÓN VER LISTA -->
            <Button Text="Ver Lista de Desvíos"
                    Clicked="OnVerListaClicked"
                    BackgroundColor="Gray"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>